#!/usr/bin/python3

import argparse
import json
import os
import shutil
import subprocess
import sys
from dataclasses import asdict, dataclass
from pathlib import Path
from typing import Any, Dict, Iterable, List, Optional


BITSTREAM_SUFFIXES = (".bit.bin", ".bit", ".bin")


class FirmwareError(RuntimeError):
    pass


@dataclass
class ControllerConfig:
    xilinx_fw_dir: Path = Path("/lib/firmware/xilinx")
    overlay_fw_dir: Path = Path("/lib/firmware/overlays")
    state_dir: Path = Path("/run/pl-firmwarectl")
    configfs_overlays: Path = Path("/sys/kernel/config/device-tree/overlays")
    fpgautil: str = "fpgautil"
    dtoverlay: str = "dtoverlay"

    @classmethod
    def from_env(cls) -> "ControllerConfig":
        return cls(
            xilinx_fw_dir=Path(os.getenv("XILINX_FW_DIR", str(cls.xilinx_fw_dir))),
            overlay_fw_dir=Path(os.getenv("OVERLAY_FW_DIR", str(cls.overlay_fw_dir))),
            state_dir=Path(os.getenv("STATE_DIR", str(cls.state_dir))),
            configfs_overlays=Path(os.getenv("CONFIGFS_OVERLAYS", str(cls.configfs_overlays))),
            fpgautil=os.getenv("FPGAUTIL", cls.fpgautil),
            dtoverlay=os.getenv("DTOVERLAY", cls.dtoverlay),
        )


@dataclass
class CommandResult:
    ok: bool
    message: str
    data: Dict[str, Any]


class FirmwareController:
    """Runtime FPGA and device-tree overlay operations.

    The CLI is deliberately thin. A future daemon can instantiate this class
    and call execute_json_command() or the individual methods directly.
    """

    def __init__(self, config: ControllerConfig):
        self.config = config
        self.project_state_file = config.state_dir / "active-project.json"
        self.overlay_state_file = config.state_dir / "active-overlays.json"

    def execute_json_command(self, command: Dict[str, Any]) -> CommandResult:
        action = command.get("action")
        args = command.get("args", {})
        if not isinstance(args, dict):
            raise FirmwareError("JSON command 'args' must be an object")

        dispatch = {
            "status": lambda: self.status(),
            "list_projects": lambda: self.list_projects(),
            "list_overlays": lambda: self.list_overlays(args.get("project")),
            "load_project": lambda: self.load_project(**args),
            "unload_project": lambda: self.unload_project(args.get("project")),
            "load_overlay": lambda: self.load_overlay(**args),
            "unload_overlay": lambda: self.unload_overlay(args.get("overlay")),
        }

        handler = dispatch.get(action)
        if handler is None:
            raise FirmwareError(f"unknown JSON action: {action}")
        return handler()

    def status(self) -> CommandResult:
        data: Dict[str, Any] = {
            "xilinx_fw_dir": str(self.config.xilinx_fw_dir),
            "overlay_fw_dir": str(self.config.overlay_fw_dir),
            "active_project": self._read_project_state(),
            "active_overlays": self._read_overlay_state(),
        }

        if shutil.which(self.config.dtoverlay):
            proc = self._run([self.config.dtoverlay, "-l"], check=False)
            data["dtoverlay"] = proc.stdout.strip().splitlines()

        return CommandResult(True, "status collected", data)

    def list_projects(self) -> CommandResult:
        root = self.config.xilinx_fw_dir
        if not root.is_dir():
            raise FirmwareError(f"project directory not found: {root}")
        projects = sorted(path.name for path in root.iterdir() if path.is_dir())
        return CommandResult(True, "projects listed", {"projects": projects})

    def list_overlays(self, project: Optional[str] = None) -> CommandResult:
        root = self._project_dir(project) if project else self.config.overlay_fw_dir
        if not root.is_dir():
            raise FirmwareError(f"overlay directory not found: {root}")
        overlays = sorted(path.name for path in root.glob("*.dtbo") if path.is_file())
        return CommandResult(True, "overlays listed", {"project": project, "overlays": overlays})

    def load_project(
        self,
        project: str,
        bitstream: Optional[str] = None,
        overlay: Optional[str] = None,
        no_overlay: bool = False,
        force: bool = False,
    ) -> CommandResult:
        project_dir = self._project_dir(project)
        bitstream_path = self._resolve_project_bitstream(project_dir, bitstream)
        overlay_path = None if no_overlay else self._resolve_project_overlay(project_dir, overlay)

        if self.project_state_file.exists() and not force:
            raise FirmwareError("a project is already recorded as active; unload it first or use --force")

        self._need_command(self.config.fpgautil)
        cmd = [self.config.fpgautil, "-b", str(bitstream_path)]
        if overlay_path is not None:
            cmd += ["-o", str(overlay_path)]
        self._run(cmd)

        if overlay_path is not None:
            self._remember_overlay(self._overlay_name(overlay_path), overlay_path)

        state = {
            "project": project,
            "bitstream": str(bitstream_path),
            "overlay": str(overlay_path) if overlay_path is not None else None,
        }
        self._write_project_state(state)
        return CommandResult(True, f"loaded project: {project}", state)

    def unload_project(self, project: Optional[str] = None) -> CommandResult:
        state = self._read_project_state()
        if state is None:
            return CommandResult(True, "no active project recorded", {})

        active_project = state.get("project")
        if project and project != active_project:
            raise FirmwareError(f"active project is '{active_project or 'unknown'}', not '{project}'")

        overlay = state.get("overlay")
        warnings: List[str] = []
        if overlay:
            overlay_name = self._overlay_name(Path(overlay))
            if not self._remove_project_overlay(overlay_name):
                warnings.append(f"could not unload project overlay: {overlay_name}")
            self._forget_overlay(overlay_name)

        self.project_state_file.unlink(missing_ok=True)
        warnings.append("FPGA fabric remains configured until another bitstream is loaded or the device is reset")
        return CommandResult(True, "unloaded project overlay state", {"warnings": warnings})

    def load_overlay(self, overlay: str, params: Optional[Iterable[str]] = None) -> CommandResult:
        overlay_path = self._resolve_general_overlay(overlay)
        overlay_name = self._overlay_name(overlay_path)
        args = list(params or [])

        self._need_command(self.config.dtoverlay)
        self._run([self.config.dtoverlay, "-d", str(overlay_path.parent), overlay_name] + args)
        self._remember_overlay(overlay_name, overlay_path)
        return CommandResult(True, f"loaded overlay: {overlay_name}", {"overlay": overlay_name, "path": str(overlay_path)})

    def unload_overlay(self, overlay: Optional[str]) -> CommandResult:
        if not overlay:
            raise FirmwareError("unload-overlay requires an overlay name or 'all'")

        if overlay == "all":
            warnings = []
            for entry in list(self._read_overlay_state()):
                name = entry.get("name")
                if not name:
                    continue
                if not self._remove_overlay_by_name(name):
                    warnings.append(f"could not unload overlay: {name}")
            self._write_overlay_state([])
            return CommandResult(True, "unloaded recorded overlays", {"warnings": warnings})

        name = self._overlay_name(Path(overlay))
        if not self._remove_overlay_by_name(name):
            raise FirmwareError(f"could not unload overlay: {name}")
        self._forget_overlay(name)
        return CommandResult(True, f"unloaded overlay: {name}", {"overlay": name})

    def _project_dir(self, project: str) -> Path:
        path = self.config.xilinx_fw_dir / project
        if not path.is_dir():
            raise FirmwareError(f"project not found: {project}")
        return path

    def _resolve_general_overlay(self, overlay: str) -> Path:
        candidates = [Path(overlay), self.config.overlay_fw_dir / overlay]
        if not overlay.endswith(".dtbo"):
            candidates.append(self.config.overlay_fw_dir / f"{overlay}.dtbo")
        for candidate in candidates:
            if candidate.is_file():
                return candidate.resolve()
        raise FirmwareError(f"overlay not found: {overlay}")

    def _resolve_project_bitstream(self, project_dir: Path, requested: Optional[str]) -> Path:
        if requested:
            return self._resolve_project_file(project_dir, requested, "bitstream")

        matches = sorted(
            path for path in project_dir.iterdir()
            if path.is_file() and path.name.endswith(BITSTREAM_SUFFIXES)
        )
        if not matches:
            raise FirmwareError(f"no bitstream found in {project_dir}")
        return matches[0].resolve()

    def _resolve_project_overlay(self, project_dir: Path, requested: Optional[str]) -> Optional[Path]:
        if requested:
            return self._resolve_project_file(project_dir, requested, "project overlay")

        matches = sorted(path for path in project_dir.glob("*.dtbo") if path.is_file())
        return matches[0].resolve() if matches else None

    def _resolve_project_file(self, project_dir: Path, requested: str, label: str) -> Path:
        candidates = [Path(requested), project_dir / requested]
        for candidate in candidates:
            if candidate.is_file():
                return candidate.resolve()
        raise FirmwareError(f"{label} not found: {requested}")

    def _overlay_name(self, path: Path) -> str:
        name = path.name
        return name[:-5] if name.endswith(".dtbo") else name

    def _ensure_state_dir(self) -> None:
        self.config.state_dir.mkdir(parents=True, exist_ok=True)

    def _read_project_state(self) -> Optional[Dict[str, Any]]:
        return self._read_json_file(self.project_state_file, None)

    def _write_project_state(self, state: Dict[str, Any]) -> None:
        self._write_json_file(self.project_state_file, state)

    def _read_overlay_state(self) -> List[Dict[str, str]]:
        return self._read_json_file(self.overlay_state_file, [])

    def _write_overlay_state(self, state: List[Dict[str, str]]) -> None:
        self._write_json_file(self.overlay_state_file, state)

    def _remember_overlay(self, name: str, path: Path) -> None:
        state = [entry for entry in self._read_overlay_state() if entry.get("name") != name]
        state.append({"name": name, "path": str(path)})
        self._write_overlay_state(state)

    def _forget_overlay(self, name: str) -> None:
        state = [entry for entry in self._read_overlay_state() if entry.get("name") != name]
        self._write_overlay_state(state)

    def _read_json_file(self, path: Path, default: Any) -> Any:
        if not path.exists():
            return default
        with path.open("r", encoding="utf-8") as handle:
            return json.load(handle)

    def _write_json_file(self, path: Path, data: Any) -> None:
        self._ensure_state_dir()
        tmp = path.with_suffix(path.suffix + f".{os.getpid()}.tmp")
        with tmp.open("w", encoding="utf-8") as handle:
            json.dump(data, handle, indent=2, sort_keys=True)
            handle.write("\n")
        tmp.replace(path)

    def _remove_overlay_by_name(self, name: str) -> bool:
        overlay_path = self._resolve_general_overlay(name)

        self._need_command(self.config.dtoverlay)
        proc = self._run([self.config.dtoverlay, "-d", str(overlay_path.parent), "-r", name], check=False)
        if proc.returncode == 0:
            return True

        configfs_path = self.config.configfs_overlays / name
        if configfs_path.is_dir():
            try:
                configfs_path.rmdir()
                return True
            except OSError:
                return False
        return False

    def _remove_project_overlay(self, name: str) -> bool:
        if shutil.which(self.config.fpgautil):
            proc = self._run([self.config.fpgautil, "-R", "-n", "full"], check=False)
            if proc.returncode == 0:
                return True
        return self._remove_overlay_by_name(name)

    def _need_command(self, name: str) -> None:
        if shutil.which(name) is None:
            raise FirmwareError(f"missing required command: {name}")

    def _run(self, cmd: List[str], check: bool = True) -> subprocess.CompletedProcess:
        proc = subprocess.run(cmd, check=False, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if check and proc.returncode != 0:
            detail = proc.stderr.strip() or proc.stdout.strip()
            raise FirmwareError(f"command failed ({' '.join(cmd)}): {detail}")
        return proc


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="pl-firmwarectl",
        description="Manage runtime Zynq bitstreams and device-tree overlays.",
    )
    parser.add_argument("--json", action="store_true", help="print machine-readable JSON output")
    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("status")
    subparsers.add_parser("list-projects")

    list_overlays = subparsers.add_parser("list-overlays")
    list_overlays.add_argument("--project")

    load_project = subparsers.add_parser("load-project")
    load_project.add_argument("project")
    load_project.add_argument("--bitstream")
    load_project.add_argument("--overlay")
    load_project.add_argument("--no-overlay", action="store_true")
    load_project.add_argument("--force", action="store_true")

    unload_project = subparsers.add_parser("unload-project")
    unload_project.add_argument("project", nargs="?")

    load_overlay = subparsers.add_parser("load-overlay")
    load_overlay.add_argument("overlay")
    load_overlay.add_argument("params", nargs="*")

    unload_overlay = subparsers.add_parser("unload-overlay")
    unload_overlay.add_argument("overlay")

    return parser


def result_from_args(controller: FirmwareController, args: argparse.Namespace) -> CommandResult:
    if args.command == "status":
        return controller.status()
    if args.command == "list-projects":
        return controller.list_projects()
    if args.command == "list-overlays":
        return controller.list_overlays(args.project)
    if args.command == "load-project":
        return controller.load_project(
            project=args.project,
            bitstream=args.bitstream,
            overlay=args.overlay,
            no_overlay=args.no_overlay,
            force=args.force,
        )
    if args.command == "unload-project":
        return controller.unload_project(args.project)
    if args.command == "load-overlay":
        return controller.load_overlay(args.overlay, args.params)
    if args.command == "unload-overlay":
        return controller.unload_overlay(args.overlay)
    raise FirmwareError(f"unknown command: {args.command}")


def print_result(result: CommandResult, json_output: bool) -> None:
    if json_output:
        print(json.dumps(asdict(result), indent=2, sort_keys=True))
        return

    data = result.data
    if "active_project" in data:
        print(f"Bitstream projects: {data['xilinx_fw_dir']}")
        print(f"General overlays:   {data['overlay_fw_dir']}")
        print()
        print("Active project:")
        print(json.dumps(data["active_project"], indent=2, sort_keys=True) if data["active_project"] else "none recorded")
        print()
        print("Overlays recorded by pl-firmwarectl:")
        overlays = data["active_overlays"]
        print(json.dumps(overlays, indent=2, sort_keys=True) if overlays else "none")
        if "dtoverlay" in data:
            print()
            print("dtoverlay reports:")
            print("\n".join(data["dtoverlay"]))
        return
    if "projects" in data:
        print("\n".join(data["projects"]))
        return
    if "overlays" in data:
        print("\n".join(data["overlays"]))
        return
    if result.message:
        print(result.message)
    for warning in data.get("warnings", []):
        print(f"warning: {warning}", file=sys.stderr)


def main(argv: Optional[List[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    controller = FirmwareController(ControllerConfig.from_env())

    try:
        result = result_from_args(controller, args)
        print_result(result, args.json)
        return 0
    except FirmwareError as exc:
        if args.json:
            print(json.dumps({"ok": False, "message": str(exc), "data": {}}, indent=2, sort_keys=True))
        else:
            print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
